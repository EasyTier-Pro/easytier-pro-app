index 00000000..b62aaf59
--- /dev/null
+++ b/easytier-contrib/easytier-ffi/src/mobile_tun.rs
@@ -0,0 +1,81 @@
+use std::ffi::{CStr, CString, c_char, c_int};
+
+use uuid::Uuid;
+
+use crate::{config_server::in_config_server_callback, error::set_error_msg};
+
+unsafe fn instance_ids(value: *const c_char) -> Result<Option<Vec<Uuid>>, String> {
+    if value.is_null() {
+        return Ok(None);
+    }
+    let value = unsafe { CStr::from_ptr(value) }
+        .to_str()
+        .map_err(|error| format!("invalid instance IDs: {error}"))?;
+    serde_json::from_str(value)
+        .map(Some)
+        .map_err(|error| format!("invalid instance IDs: {error}"))
+}
+
+fn response(result: Result<String, String>) -> *mut c_char {
+    match result.and_then(|json| CString::new(json).map_err(|error| error.to_string())) {
+        Ok(json) => json.into_raw(),
+        Err(error) => {
+            set_error_msg(&error);
+            std::ptr::null_mut()
+        }
+    }
+}
+
+pub(crate) unsafe fn get_config(instance_ids_json: *const c_char) -> *mut c_char {
+    response((|| {
+        if in_config_server_callback() {
+            return Err("cannot get mobile TUN config from config server callback".to_owned());
+        }
+        let ids = unsafe { instance_ids(instance_ids_json) }?
+            .ok_or_else(|| "instance IDs must not be null".to_owned())?;
+        #[cfg(any(target_os = "android", target_os = "ios"))]
+        {
+            let context = crate::state::ffi_context();
+            let config =
+                context
+                    .runtime
+                    .block_on(easytier::instance::factory::get_mobile_tun_config(
+                        &context.manager,
+                        &ids,
+                    ));
+            serde_json::to_string(&config).map_err(|error| error.to_string())
+        }
+        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        {
+            let _ = ids;
+            Err("mobile TUN configuration is unavailable on this platform".to_owned())
+        }
+    })())
+}
+
+pub(crate) unsafe fn attach(fd: c_int, instance_ids_json: *const c_char) -> *mut c_char {
+    response((|| {
+        if in_config_server_callback() {
+            return Err("cannot attach mobile TUN from config server callback".to_owned());
+        }
+        let ids = unsafe { instance_ids(instance_ids_json) }?;
+        #[cfg(any(target_os = "android", target_os = "ios"))]
+        {
+            let context = crate::state::ffi_context();
+            let config = context
+                .runtime
+                .block_on(easytier::instance::factory::attach_mobile_tun_fd(
+                    &context.manager,
+                    fd,
+                    ids.as_deref(),
+                ))
+                .map_err(|error| format!("{error:#}"))?;
+            serde_json::to_string(&config).map_err(|error| error.to_string())
+        }
+        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        {
+            let _ = (fd, ids);
+            Err("mobile TUN attachment is unavailable on this platform".to_owned())
+        }
+    })())
+}
