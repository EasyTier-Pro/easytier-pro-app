+pub(crate) fn mobile_tun_jni(
+    mut env: JNIEnv,
+    instance_ids_json: JString,
+    fd: Option<jint>,
+) -> jstring {
+    let ids = if instance_ids_json.is_null() {
+        None
+    } else {
+        match jstring_to_cstring(&mut env, &instance_ids_json) {
+            Ok(ids) => Some(ids),
+            Err(error) => {
+                throw_exception(&mut env, &format!("Invalid instance IDs: {error}"));
+                return ptr::null_mut();
+            }
+        }
+    };
+    let ids_ptr = ids.as_ref().map_or(ptr::null(), |ids| ids.as_ptr());
+    unsafe {
+        let response = match fd {
+            Some(fd) => easytier_ffi::attach_mobile_tun_fd(fd, ids_ptr),
+            None => easytier_ffi::get_mobile_tun_config(ids_ptr),
+        };
+        if response.is_null() {
+            if let Some(error) = get_last_error() {
+                throw_exception(&mut env, &error);
+            }
+            return ptr::null_mut();
+        }
+        let json = CStr::from_ptr(response).to_string_lossy().into_owned();
+        free_string(response);
+        match env.new_string(json) {
+            Ok(value) => value.into_raw(),
+            Err(error) => {
+                throw_exception(
+                    &mut env,
+                    &format!("Failed to create mobile TUN JSON: {error}"),
+                );
+                ptr::null_mut()
+            }
+        }
+    }
+}
