+/// Get shared mobile TUN settings for a JSON array of instance UUID strings.
+///
+/// Uses the same instance manager as local and config-server instances. The
+/// returned JSON contains `instance_ids`, `addresses`, `routes`, `dns`,
+/// `search_domains`, and
+/// per-member `rejected` errors. Conflicting members do not displace unchanged
+/// attached members. Only Android and iOS support this operation.
+///
+/// Returns an allocated JSON string, or null on failure. Release it with
+/// `free_string`; retrieve failures with `get_error_msg` on the same thread.
+/// Do not call this from a config-server event callback.
+///
+/// # Safety
+/// `instance_ids_json` must point to a NUL-terminated UTF-8 JSON array.
+#[cfg_attr(feature = "c-abi", unsafe(no_mangle))]
+pub unsafe extern "C" fn get_mobile_tun_config(instance_ids_json: *const c_char) -> *mut c_char {
+    unsafe { mobile_tun::get_config(instance_ids_json) }
+}
+
+/// Attach a shared mobile TUN and wait for its members to finish attaching.
+///
+/// `instance_ids_json` is a JSON array of UUID strings; null selects all running
+/// TUN-enabled instances. An empty array attaches no members. `fd <= 0` detaches
+/// every member. Positive descriptors remain owned by the caller, who must
+/// detach them before closing. A successful replacement also releases the
+/// previously attached descriptor. Rejected and deselected members are detached;
+/// this does not stop or delete network instances.
+/// Serialize calls with host VPN reconfiguration. Do not invoke this from a
+/// config-server event callback. Only Android and iOS support this operation.
+///
+/// Returns the actual accepted configuration and rejected members in the same
+/// JSON shape as `get_mobile_tun_config`, or null on failure. Release the result
+/// with `free_string`; retrieve failures with `get_error_msg` on the same thread.
+///
+/// # Safety
+/// `instance_ids_json`, when non-null, must point to a NUL-terminated UTF-8 JSON
+/// array. A positive `fd` must be a valid TUN descriptor retained by the caller.
+#[cfg_attr(feature = "c-abi", unsafe(no_mangle))]
+pub unsafe extern "C" fn attach_mobile_tun_fd(
+    fd: c_int,
+    instance_ids_json: *const c_char,
+) -> *mut c_char {
+    unsafe { mobile_tun::attach(fd, instance_ids_json) }
+}
