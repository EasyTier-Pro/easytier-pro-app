diff --git a/easytier/src/instance/shared_virtual_nic/tests.rs b/easytier/src/instance/shared_virtual_nic/tests.rs
index e228144b..f3a4f662 100644
--- a/easytier/src/instance/shared_virtual_nic/tests.rs
+++ b/easytier/src/instance/shared_virtual_nic/tests.rs
@@ -7,6 +7,55 @@ use super::*;
 const MEMBER: SharedVirtualNicMemberId = uuid::Uuid::from_u128(1);
 const REGISTRATION: SharedVirtualNicMemberRegistrationId = uuid::Uuid::from_u128(10);
 
+#[tokio::test]
+async fn member_shutdown_waits_for_cleanup_and_keeps_other_members() {
+    let shared_nic = Arc::new(Mutex::new(SharedVirtualNic::new(virtual_nic_config(
+        1500, None,
+    ))));
+    let tunnel_table = shared_nic.lock().await.member_tunnel_table();
+    let members = [1, 2].map(|id| {
+        SharedVirtualNicMember::new(
+            uuid::Uuid::from_u128(id),
+            1500,
+            shared_nic.clone(),
+            Arc::new(Notify::new()),
+            tunnel_table.clone(),
+        )
+    });
+    let mut guard = shared_nic.lock().await;
+    for member in &members {
+        guard
+            .member_registrations
+            .insert(member.member_id, member.registration.registration_id);
+    }
+
+    let mut shutdown = Box::pin(members[0].shutdown());
+    assert!(futures::poll!(shutdown.as_mut()).is_pending());
+    assert!(
+        guard
+            .member_registrations
+            .contains_key(&members[0].member_id)
+    );
+    drop(guard);
+    tokio::time::timeout(std::time::Duration::from_secs(5), shutdown)
+        .await
+        .unwrap();
+
+    let guard = shared_nic.lock().await;
+    assert!(
+        !guard
+            .member_registrations
+            .contains_key(&members[0].member_id)
+    );
+    assert_eq!(
+        guard.member_registrations.get(&members[1].member_id),
+        Some(&members[1].registration.registration_id)
+    );
+    drop(guard);
+    members[1].shutdown().await;
+    assert!(shared_nic.lock().await.member_registrations.is_empty());
+}
+
 #[cfg(target_os = "windows")]
 #[tokio::test]
 #[ignore = "requires Administrator privileges and wintun.dll"]
