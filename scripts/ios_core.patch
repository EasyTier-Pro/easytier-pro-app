+/// Snapshot of the current attachment, for pairing callbacks with set_tun_fd.
+/// Returns JSON null when the instance has already been removed.
+///
+/// # Safety
+/// `instance_name` must be a valid NUL-terminated UTF-8 string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn easytier_ios_tun_state(instance_name: *const c_char) -> *mut c_char {
+    unsafe {
+        guarded(ptr::null_mut(), || {
+            error::clear_error();
+            let result = cstr_arg(instance_name, "instance_name")
+                .and_then(easytier_ffi::network_instance_tun_state);
+            match result {
+                Ok(state) => {
+                    match cstring_for(&serde_json::to_string(&state).unwrap(), "TUN state") {
+                        Ok(value) => value.into_raw(),
+                        Err(err) => {
+                            error::set_error(&err.to_string());
+                            ptr::null_mut()
+                        }
+                    }
+                }
+                Err(message) => {
+                    error::set_error(&message);
+                    ptr::null_mut()
+                }
+            }
+        })
+    }
+}
