+#[tokio::test]
+async fn config_server_runtime_notifies_and_stop_drains_delivery() {
+    let events: Mutex<Vec<String>> = Mutex::new(Vec::new());
+    let hooks = ManagedConfigServerClientHooks::new(
+        Some(record_config_server_event),
+        &events as *const _ as *mut c_void,
+    );
+    let cfg = TomlConfigLoader::default();
+    let id = Uuid::new_v4();
+    cfg.set_id(id);
+    cfg.set_inst_name(format!("event-{id}"));
+    cfg.set_listeners(Vec::new());
+    ffi_context()
+        .manager
+        .run_network_instance(cfg, ConfigFileControl::STATIC_CONFIG)
+        .unwrap();
+    hooks.post_run_network_instance(&id).await.unwrap();
+    let instance = ffi_context().manager.instance(id).unwrap();
+    easytier_core::management::apply_config_patch(
+        &instance,
+        easytier::proto::api::config::InstanceConfigPatch {
+            hostname: Some("event-before-stop".to_owned()),
+            ..Default::default()
+        },
+        None,
+    )
+    .await
+    .unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            if events.lock().unwrap().iter().any(|raw| {
+                let event: Value = serde_json::from_str(raw).unwrap();
+                event["event"] == "network_instance_event" && event["runtime"]["tun"].is_array()
+            }) {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    hooks.start_stopping();
+    let delivered = events.lock().unwrap().len();
+    easytier_core::management::apply_config_patch(
+        &instance,
+        easytier::proto::api::config::InstanceConfigPatch {
+            hostname: Some("event-after-stop".to_owned()),
+            ..Default::default()
+        },
+        None,
+    )
+    .await
+    .unwrap();
+    tokio::task::yield_now().await;
+    assert_eq!(events.lock().unwrap().len(), delivered);
+    ffi_context()
+        .process_management
+        .delete_owned_network_instances(vec![id])
+        .await
+        .unwrap();
+}
