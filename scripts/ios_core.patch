+#[cfg(test)]
+mod tests {
+    use std::{os::unix::net::UnixDatagram, time::Duration};
+
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    use super::*;
+
+    #[tokio::test]
+    async fn full_datagram_queue_waits_for_the_reader() {
+        let (writer, reader) = UnixDatagram::pair().unwrap();
+        writer.set_nonblocking(true).unwrap();
+        reader.set_nonblocking(true).unwrap();
+        let packet = vec![0x45; 1232];
+        let mut writer = AsyncDevice::new(writer).unwrap();
+        // Cache writable readiness before filling the peer's queue. ENOBUFS
+        // must invalidate that readiness instead of escaping as an I/O error.
+        writer.write_all(&packet).await.unwrap();
+        let mut queued = 1;
+        loop {
+            match writer.inner.get_ref().send(&packet) {
+                Ok(_) => queued += 1,
+                Err(error) if error.raw_os_error() == Some(libc::ENOBUFS) => break,
+                Err(error) => panic!("unexpected send error: {error}"),
+            }
+        }
+        assert!(queued > 0);
+        let sent = packet.clone();
+        let mut task = tokio::spawn(async move { writer.write_all(&sent).await });
+        assert!(
+            tokio::time::timeout(Duration::from_millis(50), &mut task)
+                .await
+                .is_err()
+        );
+        let mut received = vec![0; packet.len()];
+        for _ in 0..queued {
+            assert_eq!(reader.recv(&mut received).unwrap(), packet.len());
+            assert_eq!(received, packet);
+        }
+        tokio::time::timeout(Duration::from_secs(1), task)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(reader.recv(&mut received).unwrap(), packet.len());
+        assert_eq!(received, packet);
+    }
+
+    #[tokio::test]
+    async fn datagram_reads_preserve_packet_boundaries() {
+        let (writer, reader) = UnixDatagram::pair().unwrap();
+        let mut reader = AsyncDevice::new(reader).unwrap();
+        writer.send(&[1, 2, 3]).unwrap();
+        writer.send(&[4, 5]).unwrap();
+        let mut buf = [0; 32];
+        assert_eq!(reader.read(&mut buf).await.unwrap(), 3);
+        assert_eq!(&buf[..3], &[1, 2, 3]);
+        assert_eq!(reader.read(&mut buf).await.unwrap(), 2);
+        assert_eq!(&buf[..2], &[4, 5]);
+    }
+}
