+/// Snapshot of the named native instance's current TUN attachment.
+/// Absence is normal when removal overtakes a queued runtime notification.
+pub fn network_instance_tun_state(name: &str) -> Result<Option<(u64, bool, bool)>, String> {
+    let Some(id) = state::resolve_instance_id_by_name(name)? else {
+        return Ok(None);
+    };
+    let Some(instance) = state::ffi_context().manager.instance(id) else {
+        return Ok(None);
+    };
+    Ok(Some(
+        easytier::instance::factory::native_instance_tun_state(&instance),
+    ))
+}
